{
 "sheet": "gameplay",
 "about": "The rules the mashup adds between the games. Each table is a group of like things; one row per thing, one column per property. Minecraft names are checked against the 26.3 jar (design/mc_index), RoR2 body names against RoR2's BodyCatalog.",
 "scaling": {
  "about": "Risk of Rain stats that become real Minecraft attributes or damage. ratio = ror2_stat / ror2_base. Sent when the value changes by more than min_change. mode ratio: value = mc_base x ror2_stat / ror2_base; mode add: value = mc_base + ror2_stat (stats with no base, like luck).",
  "columns": [
   "id",
   "ror2_stat",
   "ror2_base",
   "mc_target",
   "mc_base",
   "command",
   "min_change",
   "mode"
  ],
  "rows": [
   {
    "id": "max_health",
    "ror2_stat": "maxHealth",
    "ror2_base": "baseMaxHealth",
    "mc_target": "minecraft:max_health",
    "mc_base": 20.0,
    "command": "attribute",
    "min_change": 0.5,
    "mode": "ratio"
   },
   {
    "id": "move_speed",
    "ror2_stat": "moveSpeed",
    "ror2_base": "baseMoveSpeed",
    "mc_target": "minecraft:movement_speed",
    "mc_base": 0.1,
    "command": "attribute",
    "min_change": 0.002,
    "mode": "ratio"
   },
   {
    "id": "attack_speed",
    "ror2_stat": "attackSpeed",
    "ror2_base": "baseAttackSpeed",
    "mc_target": "minecraft:attack_speed",
    "mc_base": 4.0,
    "command": "attribute",
    "min_change": 0.05,
    "mode": "ratio"
   },
   {
    "id": "jump",
    "ror2_stat": "jumpPower",
    "ror2_base": "baseJumpPower",
    "mc_target": "minecraft:jump_strength",
    "mc_base": 0.42,
    "command": "attribute",
    "min_change": 0.01,
    "mode": "ratio"
   },
   {
    "id": "luck",
    "ror2_stat": "luck",
    "ror2_base": "none",
    "mc_target": "minecraft:luck",
    "mc_base": 0.0,
    "command": "attribute",
    "min_change": 0.5,
    "mode": "add"
   },
   {
    "id": "mining_speed",
    "ror2_stat": "attackSpeed",
    "ror2_base": "baseAttackSpeed",
    "mc_target": "minecraft:block_break_speed",
    "mc_base": 1.0,
    "command": "attribute",
    "min_change": 0.05,
    "mode": "ratio"
   }
  ]
 },
 "damage": {
  "about": "How damage crosses. Outgoing: RoR2 damage = Minecraft damage x body.damage x out_per_mc. Incoming: Minecraft damage = RoR2 health lost x 20 / body.baseMaxHealth. Healing uses the same rate. The guest divides a hurt value by hurt_divisor.",
  "columns": [
   "id",
   "value",
   "note"
  ],
  "rows": [
   {
    "id": "out_per_mc",
    "value": 0.4,
    "note": "a stone sword (5) at level 1 (damage 12) hits for 24: a Lemurian (80 HP) in about 4 hits"
   },
   {
    "id": "proc_coefficient",
    "value": 1.0,
    "note": "Minecraft hits proc RoR2 on-hit items fully"
   },
   {
    "id": "hurt_divisor",
    "value": 5.0,
    "note": "SkyCombat.SKYRIM_TO_MC_DAMAGE in the guest"
   },
   {
    "id": "max_hit_distance",
    "value": 12.0,
    "note": "server rejects a Steve hit on a target further than this many metres from the Steve"
   },
   {
    "id": "heal_batch_seconds",
    "value": 0.5,
    "note": "server sums healing per Steve and sends at most this often"
   }
  ]
 },

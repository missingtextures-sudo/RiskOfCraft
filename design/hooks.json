{
 "sheet": "hooks",
 "about": "Every place the mashup touches either game. One row per hook. game: ror2 (BepInEx/Harmony, checked against RoR2.dll build 25475991) or minecraft (Fabric mod). kind: prefix/postfix (Harmony), event (subscribe), call (we call it), mixin/callback (Fabric). gate: when the hook acts. module: the source file that implements it.",
 "columns": [
  "id",
  "game",
  "target",
  "kind",
  "gate",
  "does",
  "module"
 ],
 "rows": [
  {
   "id": "input_move",
   "game": "ror2",
   "target": "RoR2.PlayerCharacterMasterController.Update",
   "kind": "postfix",
   "gate": "local body follows Minecraft",
   "does": "zero moveVector; aimOrigin/aimDirection from Minecraft's eye and look",
   "module": "ror2/src/Patches/InputPatches.cs"
  },
  {
   "id": "input_buttons",
   "game": "ror2",
   "target": "RoR2.PlayerCharacterMasterController.PollButtonInput",
   "kind": "postfix",
   "gate": "local body follows Minecraft",
   "does": "skills, jump, sprint off; interact from G, equipment from R",
   "module": "ror2/src/Patches/InputPatches.cs"
  },
  {
   "id": "motor_velocity",
   "game": "ror2",
   "target": "RoR2.CharacterMotor.UpdateVelocity",

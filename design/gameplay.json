 "commands": {
  "about": "Minecraft commands the host sends through the command ring. {x} are filled in by the host. All run as the player with operator rights.",
  "columns": [
   "id",
   "template",
   "sent_when"
  ],
  "rows": [
   {
    "id": "reset_run",
    "template": "riskofcraft reset_run",
    "sent_when": "a run starts"
   },
   {
    "id": "give",
    "template": "give @s minecraft:{item} {count}",
    "sent_when": "starter kit"
   },
   {
    "id": "loot",
    "template": "loot give @s loot minecraft:{table}",
    "sent_when": "chest opened or monster killed by this Steve"
   },
   {
    "id": "xp",
    "template": "xp add @s {points} points",
    "sent_when": "monster killed by this Steve"
   },
   {
    "id": "heal",
    "template": "riskofcraft heal {amount}",
    "sent_when": "RoR2 healing or regen on this Steve"
   },
   {
    "id": "attribute",
    "template": "attribute @s {attribute} base set {value}",
    "sent_when": "a scaling stat changed"
   },
   {
    "id": "time",
    "template": "time set {ticks}",
    "sent_when": "a stage starts (day for bright stages)"
   },
   {
    "id": "clear_stage",
    "template": "riskofcraft clear_placed",
    "sent_when": "a stage starts: blocks placed on the last stage go"
   },
   {
    "id": "kill_items",
    "template": "kill @e[type=minecraft:item]",
    "sent_when": "a stage starts"
   },
   {
    "id": "kill_arrows",
    "template": "kill @e[type=minecraft:arrow]",
    "sent_when": "a stage starts"
   },
   {
    "id": "kill_villagers",
    "template": "kill @e[type=minecraft:villager]",
    "sent_when": "a stage starts"
   },
   {
    "id": "kill_displays",
    "template": "kill @e[type=minecraft:item_display]",
    "sent_when": "a stage starts"
   },
   {
    "id": "kill_crystals",
    "template": "kill @e[type=minecraft:end_crystal]",
    "sent_when": "a stage starts"
   },
   {
    "id": "kill_dragons",
    "template": "riskofcraft clear_dragons",
    "sent_when": "a stage starts"
   },
   {
    "id": "place_chest",
    "template": "riskofcraft place_chest {x} {y} {z} {table} {facing}",
    "sent_when": "a stage starts: random Minecraft chests"
   },
   {
    "id": "end_portal",
    "template": "riskofcraft end_portal {x} {y} {z} {eye_chance}",
    "sent_when": "stage 5 starts: the stronghold portal near the teleporter"
   },
   {
    "id": "decor",
    "template": "riskofcraft decor {kind} {x} {y} {z} {seed}",
    "sent_when": "a custom stage starts: Minecraft decorations"
   },
   {
    "id": "end_arena",
    "template": "riskofcraft end_arena {x} {y} {z} {pillars} {radius} {caged}",
    "sent_when": "The End starts"
   },
   {
    "id": "summon_dragon",
    "template": "riskofcraft summon_dragon {x} {y} {z} {health}",
    "sent_when": "The End starts"
   },
   {
    "id": "send_texture",
    "template": "riskofcraft send_texture {id} {texture}",
    "sent_when": "a custom stage starts: block textures for the retexture"
   },
   {
    "id": "villager",
    "template": "riskofcraft villager {x} {y} {z} {profession} {level} {biome_type} {yaw}",
    "sent_when": "in the Bazaar"
   },
   {
    "id": "item_display",
    "template": "riskofcraft item_display {x} {y} {z} {item}",
    "sent_when": "in the Bazaar: the item over each Minecraft terminal"
   },
   {
    "id": "give_rare",
    "template": "give @s minecraft:{item} {count}",
    "sent_when": "a Minecraft terminal bought"
   },
   {
    "id": "credits",
    "template": "riskofcraft credits",
    "sent_when": "the Ender Dragon died (every player)"
   },
   {
    "id": "stage_mob",
    "template": "riskofcraft stage_mob {entity} {x} {y} {z} {cap} {health} {damage}",
    "sent_when": "The Nether: every few seconds while under the cap"
   },
   {
    "id": "clear_mobs",
    "template": "riskofcraft clear_mobs",
    "sent_when": "a stage starts"
   }
  ]
 },
 "keybinds": {
  "about": "Keys the host keeps while Minecraft has the keyboard. Every other key and the mouse go to Minecraft.",
  "columns": [
   "id",
   "key",
   "goes_to",
   "does"
  ],
  "rows": [
   {
    "id": "interact",
    "key": "G",
    "goes_to": "ror2",
    "does": "RoR2 interact: chests, shrines, teleporter, printers"
   },
   {
    "id": "equipment",
    "key": "R",
    "goes_to": "ror2",
    "does": "use the RoR2 equipment"
   },
   {
    "id": "pause",
    "key": "Escape",
    "goes_to": "ror2",
    "does": "RoR2 pause menu, or closes an open Minecraft screen"
   },
   {
    "id": "mc_menu",
    "key": "O",
    "goes_to": "minecraft",
    "does": "Minecraft's pause and options menu"
   },
   {
    "id": "scoreboard",
    "key": "Tab",
    "goes_to": "both",
    "does": "RoR2 scoreboard and Minecraft player list"
   }
  ]
 },
 "messages": {
  "about": "Risk of Rain 2 network messages between each player's game and the host's (UNet, so co-op works).",
  "columns": [
   "id",
   "msg_type",
   "direction",
   "fields",
   "handler"
  ],
  "rows": [
   {
    "id": "steve_linked",
    "msg_type": 31001,
    "direction": "client->server",
    "fields": "bool linked",
    "handler": "SteveRegistry.SetLinked"
   },
   {
    "id": "steve_hit",
    "msg_type": 31002,
    "direction": "client->server",
    "fields": "uint target, float mcDamage, uint flags, uint weapon, Vector3 hitPos",
    "handler": "Combat.ServerHit"
   },
   {
    "id": "steve_died",
    "msg_type": 31003,
    "direction": "client->server",
    "fields": "(none)",
    "handler": "SteveRegistry.ServerKill"
   },
   {
    "id": "mc_command",
    "msg_type": 31004,

   "gate": "local body follows Minecraft",
   "does": "no RoR2 gravity or movement; velocity zero",
   "module": "ror2/src/Patches/MotorPatches.cs"
  },
  {
   "id": "motor_rotation",
   "game": "ror2",
   "target": "RoR2.CharacterDirection.yaw",
